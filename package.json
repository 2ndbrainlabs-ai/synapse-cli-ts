{
  "name": "@2ndbrainlabs-ai/synapse-cli",
  "version": "0.1.4-re-2",
  "description": "Agentic MCP server generator \u2014 the first piece of Synapse's Enterprise Context Engine",
  "homepage": "https://synaps3.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2ndbrainlabs-ai/synapse-cli.git"
  },
  "bugs": {
    "url": "https://github.com/2ndbrainlabs-ai/synapse-cli/issues"
  },
  "type": "module",
  "bin": {
    "synapse": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "protos",
    "config.json",
    "docs/logo.png"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run typecheck:tests && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0",
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "ora": "^8.0.0",
    "tree-sitter": "^0.22.0",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.23.0",
    "tree-sitter-rust": "^0.23.3",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "cli",
    "code-generation",
    "synapse"
  ],
  "license": "Apache-2.0"
}
