{
  "name": "@2ndbrainlabs-ai/synapse-cli",
  "version": "0.1.0",
  "description": "Synapse CLI - Agentic MCP Server Generator",
  "type": "module",
  "bin": {
    "synapse": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "protos"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "cli-table3": "^0.6.0",
    "dotenv": "^16.4.0",
    "fernet": "^0.4.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0",
    "@lancedb/lancedb": "^0.14.0",
    "@xenova/transformers": "^2.17.0",
    "tree-sitter": "^0.22.0",
    "tree-sitter-python": "^0.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "cli",
    "code-generation",
    "synapse"
  ],
  "license": "MIT"
}
